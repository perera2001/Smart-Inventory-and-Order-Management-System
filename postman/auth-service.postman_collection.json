{
  "info": {
    "_postman_id": "350c55f5-c40f-41d9-88bf-ce48a89903cd",
    "name": "Auth Service API",
    "description": "Import this collection into Postman and run it in order. It creates a unique user, stores user/admin JWTs automatically, and tests public and protected endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4040", "type": "string" },
    { "key": "testEmail", "value": "", "type": "string" },
    { "key": "testPassword", "value": "Test@1234", "type": "string" },
    { "key": "userToken", "value": "", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "01 - Register User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('testEmail', `nandun.${Date.now()}@example.com`);",
                  "pm.collectionVariables.unset('userToken');",
                  "pm.collectionVariables.unset('adminToken');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Registration succeeded', () => {",
                  "  const response = pm.response.json();",
                  "  pm.expect(response.code).to.eql(201);",
                  "  pm.expect(response.data.email).to.eql(pm.collectionVariables.get('testEmail'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nandun Perera\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"confirmPassword\": \"{{testPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/register",
            "description": "Creates a USER account with a unique email generated immediately before this request."
          }
        },
        {
          "name": "02 - Reject Duplicate Email",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": ["pm.test('Status is 409 Conflict', () => pm.response.to.have.status(409));"]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Duplicate User\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"confirmPassword\": \"{{testPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "03 - Reject Password Mismatch",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": ["pm.test('Status is 400 Bad Request', () => pm.response.to.have.status(400));"]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Mismatch User\",\n  \"email\": \"mismatch@example.com\",\n  \"password\": \"Test@1234\",\n  \"confirmPassword\": \"Different@1234\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "04 - Reject Invalid Registration",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": ["pm.test('Status is 400 Bad Request', () => pm.response.to.have.status(400));"]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"A\",\n  \"email\": \"not-an-email\",\n  \"password\": \"weak\",\n  \"confirmPassword\": \"weak\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "05 - Login as User",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                "if (pm.response.code === 200) {",
                "  const response = pm.response.json();",
                "  pm.collectionVariables.set('userToken', response.data.accessToken);",
                "  pm.test('User JWT was saved', () => pm.expect(response.data.accessToken).to.be.a('string').and.not.empty);",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "Logs in the generated user and automatically stores the JWT as userToken."
          }
        },
        {
          "name": "06 - Reject Incorrect User Password",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": ["pm.test('Status is 401 Unauthorized', () => pm.response.to.have.status(401));"]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"Wrong@1234\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "07 - Login as Admin",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                "if (pm.response.code === 200) {",
                "  const response = pm.response.json();",
                "  pm.collectionVariables.set('adminToken', response.data.accessToken);",
                "  pm.test('Admin JWT was saved', () => pm.expect(response.data.accessToken).to.be.a('string').and.not.empty);",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@inventory.com\",\n  \"password\": \"Admin@123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "Uses the configured hardcoded admin credentials and stores the JWT as adminToken."
          }
        },
        {
          "name": "08 - Reject Incorrect Admin Password",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": ["pm.test('Status is 401 Unauthorized', () => pm.response.to.have.status(401));"]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@inventory.com\",\n  \"password\": \"Wrong@123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "09 - Get My User Account",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                "pm.test('Returns the logged-in user', () => pm.expect(pm.response.json().data.email).to.eql(pm.collectionVariables.get('testEmail')));"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}", "type": "text" }],
            "url": "{{baseUrl}}/api/v1/users/me"
          }
        },
        {
          "name": "10 - Get My Admin Account",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": ["pm.test('Status is 200 OK', () => pm.response.to.have.status(200));"]
            }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" }],
            "url": "{{baseUrl}}/api/v1/users/me"
          }
        },
        {
          "name": "11 - Admin Get All Users",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                "pm.test('Data is an array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}", "type": "text" }],
            "url": "{{baseUrl}}/api/v1/users/admin/all"
          }
        },
        {
          "name": "12 - Reject User from Admin Endpoint",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": ["pm.test('Status is 403 Forbidden', () => pm.response.to.have.status(403));"]
            }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}", "type": "text" }],
            "url": "{{baseUrl}}/api/v1/users/admin/all"
          }
        },
        {
          "name": "13 - Reject Missing Token",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": ["pm.test('Status is 401 Unauthorized', () => pm.response.to.have.status(401));"]
            }
          }],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/users/me"
          }
        },
        {
          "name": "14 - Reject Invalid Token",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": ["pm.test('Status is 401 Unauthorized', () => pm.response.to.have.status(401));"]
            }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer invalid.jwt.token", "type": "text" }],
            "url": "{{baseUrl}}/api/v1/users/me"
          }
        }
      ]
    }
  ]
}
